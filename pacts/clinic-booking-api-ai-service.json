{
  "consumer": {
    "name": "clinic-booking-api"
  },
  "interactions": [
    {
      "description": "a POST /recommend with empty symptoms",
      "request": {
        "body": {
          "symptoms": ""
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/recommend"
      },
      "response": {
        "body": {
          "message": "symptoms must be a non-empty string",
          "ok": false,
          "reason": "validation_error"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.reason": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 400
      }
    },
    {
      "description": "a POST /recommend with unrecognised symptoms",
      "request": {
        "body": {
          "symptoms": "xyzzy gibberish"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.symptoms": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/recommend"
      },
      "response": {
        "body": {
          "ok": false,
          "reason": "unknown_specialty"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.reason": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 422
      }
    },
    {
      "description": "a POST /recommend with valid symptoms",
      "request": {
        "body": {
          "symptoms": "heart palpitations"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.symptoms": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/recommend"
      },
      "response": {
        "body": {
          "ok": true,
          "reasoning": "Based on the reported symptoms, a Cardiologist is the most relevant specialist.",
          "specialty": "Cardiologist"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.reasoning": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.specialty": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.4.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "ai-service"
  }
}