# Running API against local SUT (see clinic-booking-api README)
BASE_URL=http://localhost:3000
# Password for users created by utils/userUtils.js (default: password — matches SUT seed convention)
# TEST_USER_PASSWORD=password
# Path to the SUT SQLite database file — used by @db tests for direct state assertions.
# Default assumes test repo and SUT repo are siblings under the same workspace folder.
# DB_PATH=../sut/data/clinic.db
# Must match RATE_LIMIT_REGISTER_MAX used when starting the SUT.
# The @rate-limit register test skips automatically when this value > 5.
# Set to 2 (and restart SUT with same value) only when intentionally testing the rate-limit path.
RATE_LIMIT_REGISTER_MAX=10000
